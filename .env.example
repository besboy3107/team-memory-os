PORT=8002
DATABASE_PATH=./data/team_memory.db

# Реальный LLM через OpenRouter (обязательно для курсового проекта)
OPENROUTER_API_KEY=sk-or-v1-...

# Модель по умолчанию — можно заменить на openai/gpt-4o-mini и т.д.
LLM_MODEL=google/gemini-flash-1.5

# Прокси (если OpenRouter недоступен напрямую)
# HTTPS_PROXY=http://127.0.0.1:10801
